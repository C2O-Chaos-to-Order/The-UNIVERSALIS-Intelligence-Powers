{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2o-universalis:intelligence-powers:governance-contracts:1.0.0",
  "title": "Portable Intelligence Powers Governance Contracts",
  "description": "Portable policy, enforcement, audit, sandbox, governance benchmark, reputation and capability-grant metadata. No C2O-private policies, keys or authority tokens.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policyBundle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "policy_id": {
          "type": "string"
        },
        "language": {
          "enum": [
            "cedar",
            "opa-rego",
            "xacml",
            "other"
          ]
        },
        "language_version": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalization": {
          "enum": [
            "UTF-8-LF-v1",
            "RFC8785-JCS",
            "language-native"
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "public_policy_text": {
          "type": "string"
        },
        "default_effect": {
          "const": "deny"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "issuer_ref": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "policy_id",
        "language",
        "language_version",
        "policy_version",
        "policy_sha256",
        "canonicalization",
        "source_ref",
        "default_effect",
        "effective_from"
      ],
      "additionalProperties": false
    },
    "authzenRequest": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "action": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "resource": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "subject",
        "action",
        "resource"
      ],
      "additionalProperties": false
    },
    "authzenResponse": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "boolean"
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "decision"
      ],
      "additionalProperties": false
    },
    "enforcementReceipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "receipt_id": {
          "type": "string"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_language": {
          "enum": [
            "cedar",
            "opa-rego",
            "xacml",
            "other"
          ]
        },
        "decision": {
          "enum": [
            "allow",
            "deny",
            "monitor",
            "hitl",
            "quarantine",
            "block",
            "revoke",
            "rate_limit",
            "redact"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "obligation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session_ref": {
          "type": "string"
        },
        "action_ref": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "signer_ref": {
          "type": "string"
        },
        "trust_anchor_ref": {
          "type": "string"
        },
        "signature_algorithm": {
          "const": "Ed25519"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "verification_status": {
          "enum": [
            "not-verified",
            "verified",
            "rejected",
            "revoked"
          ]
        },
        "fixture_only": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "receipt_id",
        "request_sha256",
        "policy_sha256",
        "policy_language",
        "decision",
        "reason_codes",
        "evidence_refs",
        "decided_at",
        "signer_ref",
        "trust_anchor_ref",
        "signature_algorithm",
        "payload_sha256",
        "signature_base64",
        "verification_status",
        "fixture_only"
      ],
      "additionalProperties": false
    },
    "auditRecord": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_id": {
          "type": "string"
        },
        "event_type": {
          "enum": [
            "INTENDED",
            "REQUESTED",
            "EVALUATED",
            "ALLOWED",
            "MONITORED",
            "HITL",
            "QUARANTINED",
            "BLOCKED",
            "ATTEMPTED",
            "EXECUTED",
            "REVOKED"
          ]
        },
        "subject_ref": {
          "type": "string"
        },
        "action_ref": {
          "type": "string"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_ref": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previous_record_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature_algorithm": {
          "enum": [
            "Ed25519",
            "none"
          ]
        },
        "signature_base64": {
          "type": "string"
        },
        "fixture_only": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "sequence",
        "event_id",
        "event_type",
        "subject_ref",
        "action_ref",
        "occurred_at",
        "evidence_refs",
        "previous_record_sha256",
        "payload_sha256",
        "record_sha256",
        "signature_algorithm",
        "fixture_only"
      ],
      "additionalProperties": false
    },
    "sandboxAttestation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "attestation_id": {
          "type": "string"
        },
        "runtime_name": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        },
        "isolation_type": {
          "enum": [
            "wasm",
            "microvm",
            "gvisor",
            "container",
            "kernel-reference-monitor",
            "hardware-watchdog",
            "other"
          ]
        },
        "workload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "network_default": {
          "const": "deny"
        },
        "filesystem_default": {
          "const": "deny"
        },
        "resource_limits": {
          "type": "object",
          "properties": {
            "cpu_millis": {
              "type": "integer",
              "minimum": 1
            },
            "memory_mib": {
              "type": "integer",
              "minimum": 1
            },
            "wall_time_ms": {
              "type": "integer",
              "minimum": 1
            },
            "process_limit": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "cpu_millis",
            "memory_mib",
            "wall_time_ms",
            "process_limit"
          ],
          "additionalProperties": false
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "assessor_ref": {
          "type": "string"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "not-run"
          ]
        },
        "fixture_only": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "attestation_id",
        "runtime_name",
        "runtime_version",
        "isolation_type",
        "workload_sha256",
        "policy_sha256",
        "config_sha256",
        "network_default",
        "filesystem_default",
        "resource_limits",
        "evidence_refs",
        "assessed_at",
        "assessor_ref",
        "result",
        "fixture_only"
      ],
      "additionalProperties": false
    },
    "dimensionScore": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "method_ref": {
          "type": "string"
        }
      },
      "required": [
        "score",
        "evidence_refs",
        "method_ref"
      ],
      "additionalProperties": false
    },
    "governanceBenchmark": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "benchmark_id": {
          "type": "string"
        },
        "rubric_version": {
          "type": "string"
        },
        "system_ref": {
          "type": "string"
        },
        "assessment_protocol_ref": {
          "type": "string"
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "policy_determinism": {
              "$ref": "#/$defs/dimensionScore"
            },
            "enforcement_latency": {
              "$ref": "#/$defs/dimensionScore"
            },
            "receipt_provenance": {
              "$ref": "#/$defs/dimensionScore"
            },
            "scope_containment": {
              "$ref": "#/$defs/dimensionScore"
            },
            "jurisdictional_enforcement": {
              "$ref": "#/$defs/dimensionScore"
            },
            "override_integrity": {
              "$ref": "#/$defs/dimensionScore"
            }
          },
          "required": [
            "policy_determinism",
            "enforcement_latency",
            "receipt_provenance",
            "scope_containment",
            "jurisdictional_enforcement",
            "override_integrity"
          ],
          "additionalProperties": false
        },
        "overall_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "tier_label": {
          "type": "string"
        },
        "tier_scheme_ref": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "independent_assessor": {
          "type": "boolean"
        },
        "fixture_only": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "benchmark_id",
        "rubric_version",
        "system_ref",
        "assessment_protocol_ref",
        "assessed_at",
        "dimensions",
        "overall_score",
        "evidence_refs",
        "independent_assessor",
        "fixture_only"
      ],
      "additionalProperties": false
    },
    "reputationSignal": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "protocol": {
          "enum": [
            "SwarmScore",
            "ClankerScore"
          ]
        },
        "protocol_version": {
          "type": "string"
        },
        "agent_ref": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "counterparty_diversity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "volatility_metric": {
          "type": "number",
          "minimum": 0
        },
        "scoring_rubric_ref": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "issuer_ref": {
          "type": "string"
        },
        "signature_ref": {
          "type": "string"
        },
        "fixture_only": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "protocol",
        "protocol_version",
        "agent_ref",
        "score",
        "confidence",
        "sample_count",
        "counterparty_diversity",
        "scoring_rubric_ref",
        "evidence_refs",
        "issued_at",
        "issuer_ref",
        "fixture_only"
      ],
      "additionalProperties": false
    },
    "capabilityGrant": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "grant_id": {
          "type": "string"
        },
        "principal_ref": {
          "type": "string"
        },
        "parent_grant_ref": {
          "type": "string"
        },
        "resource_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delegated_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revocable": {
          "const": true
        },
        "issuer_ref": {
          "type": "string"
        },
        "fixture_only": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "grant_id",
        "principal_ref",
        "resource_scope",
        "actions",
        "capabilities",
        "delegated_capabilities",
        "issued_at",
        "expires_at",
        "revocable",
        "issuer_ref",
        "fixture_only"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
